# Configuration reference. The app reads plain environment variables; nothing here is required
# in development. In production, set them through config/deploy.yml (Kamal) or your host.

# --- Public URLs ---
APP_BASE_URL=http://localhost:3000        # used for absolute links in webhook payloads
FRONTEND_URL=http://localhost:5173        # password-reset and task links in emails
CORS_ORIGINS=http://localhost:5173        # comma-separated browser origins (nothing allowed by default in production)
ALLOWED_HOSTS=                            # production Host allow-list, comma-separated

# --- Database (production) ---
DB_HOST=
TASK_API_DATABASE_PASSWORD=

# --- Email ---
MAIL_FROM="Task API <no-reply@example.com>"
SMTP_ADDRESS=                             # unset = emails are not delivered
SMTP_PORT=587

# --- Runtime ---
RAILS_MAX_THREADS=3
RAILS_LOG_LEVEL=info
LOG_FORMAT=json                           # "plain" for human-readable production logs
SOLID_QUEUE_IN_PUMA=true                  # run background jobs inside the web process
JOB_CONCURRENCY=1

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_VERSION=
