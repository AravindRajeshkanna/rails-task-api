# Configuration reference. The app reads plain environment variables; nothing here is required
# in development. In production, set them through config/deploy.yml (Kamal) or your host.

# --- Public URLs ---
APP_BASE_URL=http://localhost:3000        # used for absolute links in webhook payloads
FRONTEND_URL=http://localhost:5173        # password-reset and task links in emails
CORS_ORIGINS=http://localhost:5173        # comma-separated browser origins (nothing allowed by default in production)
ALLOWED_HOSTS=                            # production Host allow-list, comma-separated

# --- Database (production) ---
DB_HOST=
TASK_API_DATABASE_PASSWORD=

# --- Email ---
MAIL_FROM="Task API <no-reply@example.com>"
SMTP_ADDRESS=                             # unset = emails are not delivered
SMTP_PORT=587

# --- Runtime ---
RAILS_MAX_THREADS=3
RAILS_LOG_LEVEL=info
LOG_FORMAT=json                           # "plain" for human-readable production logs
RACK_ATTACK_ENABLED=true                  # false switches request throttling off (load tests; an emergency lever)
SOLID_QUEUE_IN_PUMA=true                  # run background jobs inside the web process
JOB_CONCURRENCY=1

# --- AI (Phase 1) ---
# Development and test default to the offline "fake" provider, so nothing here is needed locally.
# Production keeps AI off (endpoints answer 503 ai_not_configured) until AI_PROVIDER is set.
AI_PROVIDER=                              # bedrock | fake
AI_MODEL_ID=                              # Bedrock model or inference-profile id, e.g. from: aws bedrock list-inference-profiles
AI_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AI_EMBEDDING_DIMENSIONS=1024              # must match the tasks.embedding vector(1024) column
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT=20                             # seconds
AI_PRICE_INPUT_PER_MTOK=0                 # USD per million tokens; fill in for cost reporting
AI_PRICE_OUTPUT_PER_MTOK=0
AI_DAILY_TOKENS_PER_USER=200000           # cost control: daily budgets (UTC day)
AI_DAILY_TOKENS_PER_PROJECT=1000000
AI_REQUESTS_PER_MINUTE=20                 # per user, across the AI endpoints
AI_EMBEDDINGS=true                        # embed tasks in the background (similar-task search, assignee suggestions)
AI_GATEWAY=local                          # local = in-process; remote = the AI service
AI_SERVICE_URL=                           # e.g. http://ai:3000 when AI_GATEWAY=remote
AI_SERVICE_TOKEN=

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_VERSION=

# --- docker compose (see docker-compose.yml) ---
RAILS_MASTER_KEY=                         # cat config/master.key
AUTH_JWT_PRIVATE_KEY=                     # openssl genrsa 2048 | base64 | tr -d '\n'
AI_SERVICE_TOKEN=local-dev-service-token  # shared by the API, worker and AI service
# AUTH_MODE=jwt                           # the monolith verifies the Auth service's tokens (compose sets this)
# NOTIFICATIONS_MODE=remote               # the Notification service sends assignment/reminder emails
# EVENTS_SNS_TOPIC_ARN=                   # publish domain events to SNS
# ACTIVE_STORAGE_SERVICE=amazon           # S3 (AWS_S3_BUCKET, AWS_REGION); local disk by default
# METRICS_TOKEN=                          # protects GET /metrics (otherwise private networks only in production)
