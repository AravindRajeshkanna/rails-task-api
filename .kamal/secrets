# Secrets Kamal passes to the deploy. Values come from your shell or a password manager;
# never write a literal secret in this file (it is committed).
#
# Examples:
#   KAMAL_REGISTRY_PASSWORD=$(op read "op://Private/GitHub/token")   # 1Password
#   KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD                 # from the environment

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)
TASK_API_DATABASE_PASSWORD=$TASK_API_DATABASE_PASSWORD
# The Postgres accessory's superuser password is the same value the app uses to connect.
POSTGRES_PASSWORD=$TASK_API_DATABASE_PASSWORD
SENTRY_DSN=$SENTRY_DSN
