# Generated by deploy/scripts/render_gitops.rb from templates/ and `terraform output`. Edit the template, not this file.
image:
  repository: ${ECR_REGISTRY}/task-api/api
  tag: bootstrap                 # CI replaces this with the git SHA on every deploy
replicaCount: ${API_REPLICAS}
autoscaling: { minReplicas: ${API_REPLICAS}, maxReplicas: ${API_MAX_REPLICAS} }
secrets: { prefix: task-api/${SECRETS_ENV} }
rollout: { enabled: ${ROLLOUT_ENABLED}, analysis: { enabled: ${ROLLOUT_ENABLED} } }
env:
  APP_BASE_URL: https://${DOMAIN}
  FRONTEND_URL: https://${FRONTEND_DOMAIN}
  CORS_ORIGINS: https://${FRONTEND_DOMAIN}
  ALLOWED_HOSTS: ${DOMAIN},api,api.task-api,api.task-api.svc,api.task-api.svc.cluster.local
  DB_HOST: ${DB_ENDPOINT}
  DB_REPLICA_HOST: ${DB_READER_ENDPOINT}   # the Aurora reader endpoint: opted-in reads go there (ReplicaRouting); unset it to send everything to the writer
  AWS_REGION: ${REGION}
  APP_ENV: ${ENV}
  AUTH_ISSUER: https://${DOMAIN}
  AUTH_JWKS_URL: http://auth/.well-known/jwks.json
  EVENTS_SNS_TOPIC_ARN: ${SNS_TOPIC_ARN}
  AI_PROVIDER: ""
  AWS_S3_BUCKET: ${STORAGE_BUCKET}
  KMS_KEY_ID: ${KMS_DATA_KEY_ALIAS}   # the data key's alias (deploy/terraform/kms.tf): the same name in both regions of a pair
  READ_ONLY: "${READ_ONLY}"        # true on the standby until its database is promoted (config/initializers/read_only_mode.rb)
ingress:
  host: ${DOMAIN}
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/load-balancer-name: task-api-${ENV}
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP":80},{"HTTPS":443}]'
    alb.ingress.kubernetes.io/ssl-redirect: "443"
    alb.ingress.kubernetes.io/certificate-arn: ${ACM_CERTIFICATE_ARN}
    alb.ingress.kubernetes.io/wafv2-acl-arn: ${WAF_ACL_ARN}
    alb.ingress.kubernetes.io/ssl-policy: ELBSecurityPolicy-TLS13-1-2-2021-06
networkPolicy:
  ingressFromCIDRs: [ ${VPC_CIDR} ]
  egressToCIDRs: [ { cidr: ${VPC_CIDR}, ports: [ 5432 ] } ]
