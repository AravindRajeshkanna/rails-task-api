# Generated by deploy/scripts/render_gitops.rb. Edit the template, not this file.
image:
  repository: ${ECR_REGISTRY}/task-api/notifications
  tag: bootstrap
replicaCount: ${NOTIFICATIONS_REPLICAS}
secrets: { prefix: task-api/${SECRETS_ENV} }
env:
  DB_HOST: ${DB_ENDPOINT}
  AWS_REGION: ${REGION}
  NOTIFICATIONS_QUEUE_URL: ${NOTIFICATIONS_QUEUE_URL}
  SMTP_ADDRESS: email-smtp.${REGION}.amazonaws.com
  MAIL_FROM: "Task API <no-reply@${FRONTEND_DOMAIN}>"
  ALLOWED_HOSTS: notifications,notifications.task-api,notifications.task-api.svc,notifications.task-api.svc.cluster.local
keda:
  enabled: true
  minReplicaCount: ${NOTIFICATIONS_REPLICAS}
  maxReplicaCount: 6
  triggers:
    # Scale the consumers on the queue length; Pod Identity of the KEDA operator reads the queue attributes.
    - type: aws-sqs-queue
      metadata:
        queueURL: ${NOTIFICATIONS_QUEUE_URL}
        queueLength: "25"
        awsRegion: ${REGION}
        identityOwner: operator
networkPolicy:
  ingressFromCIDRs: [ ${VPC_CIDR} ]
  egressToCIDRs: [ { cidr: ${VPC_CIDR}, ports: [ 5432 ] } ]
